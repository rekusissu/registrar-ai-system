# Local AI API key (never commit)
shared/ai_key.local
.env
*.local

# Composer dependencies (managed via composer.lock)
/vendor/

# Composer installer (local build tool)
/composer.phar
/composer.phar.old

# Runtime / uploads
uploads/ai_docs/
uploads/students/*
!uploads/students/.htaccess
uploads/ids/*
!uploads/ids/.htaccess

# Document request module: requirement uploads + generated digital PDFs.
# User data / runtime artifacts â€” never commit (keep the .htaccess guards).
uploads/document_requirements/*
!uploads/document_requirements/.htaccess
uploads/document_pdfs/*
!uploads/document_pdfs/.htaccess

# Student profile photos written by api/student-upload-photo.php.
# User data, not source â€” but keep the .htaccess that blocks script execution.
assets/uploads/students/*
!assets/uploads/students/.htaccess

# Student file uploads (digital file storage feature)
uploads/student_files/*
# The negation must follow ITS OWN rule. It used to sit here, unpaired with the
# assets rule three lines up, so it did nothing at all: `git check-ignore` reported
# uploads/student_files/.htaccess as ignored. An .htaccess that blocks script
# execution inside the upload directory would never have been committed, let alone
# deployed - the guard was present on this machine and absent in every checkout.
!uploads/student_files/.htaccess

# Editor/tooling backup copies (*.php.backup etc.) â€” never commit these
*.backup

# Local per-station config (reader mapping per scanning PC)
/shared/config.local.php

# Database dump backups (runtime artifacts, never commit)
/backups/

# OS / editor
.DS_Store
Thumbs.db
*.log

# Test-only session injector used by the notification HTTP checks. It
# mints a logged-in session for any user id passed in the query string,
# so committing it would ship a session-forgery endpoint to the web root.
# The checks that call it are committed; this helper stays local.
tests/_session_probe.php

# Headless-screenshot scratch: renders registrar/documents.php without auth.
# Never commit this - it bypasses the session guard.
registrar/__shot.html

tests/shots/edgeprofile/
tests/shots/*.png
tests/shots/dom.txt

# Database dumps taken before a destructive test run. These are local
# safety nets, not source: they contain real rows, are large, and must
# never reach the repository.
tests/*.sql
logs/*.log
# Cached AI Insight reports. Generated on demand from the database and keyed
# by a fingerprint of the figures, so they are reproducible and must never be
# committed. The directory's .htaccess IS tracked - that is what keeps them
# from being served over HTTP.
storage/ai-insights/*
!storage/ai-insights/.htaccess

# Generated by a probe run, not source.
tests/preview_qr.svg
tests/*.svg
node_modules/

# Screenshots written to the repo ROOT by a headless probe run. These land
# wherever the command was invoked from, so a bare *.png rule would also
# swallow the icons and logos under assets/images. Named explicitly instead.
academic_print.png
insights_print.png
insights_print_page1.png
ah_design_*.png
ah_print*.png

# Same thing again, for the Status Tracker filter and dashboard probes. These
# write to the repo root from wherever the command was invoked, and every run
# produces a fresh set, so each probe needs its own prefix rather than a bare
# *.png that would also swallow assets/images.
stfilter_*.png
dash.png
st_render.html

# Rendered copies of a page, written out so a probe can measure the markup a
# browser actually built rather than what PHP emitted.
ah_render.html
ah_print_body.html

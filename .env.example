# ============================================================
#  ENVIRONMENT CONFIGURATION - COPY TO .env FOR DEPLOYMENT
# ============================================================
#  Docs every env var the application and the Docker stack read.
#  NEVER commit actual secrets — use .env (gitignored) for real values.
#  Recommended: use a secrets manager (AWS Secrets Manager, Vault, etc.).
#
#  Local Docker:        cp .env.example .env   &&   docker compose up -d --build
#  VPS behind a domain: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# ============================================================

# ── DEPLOYMENT / DOMAIN (used by docker-compose.prod.yml + deploy) ─────────
# Public hostname Caddy will serve and get a Let's Encrypt cert for.
DOMAIN=your.domain
# Optional: email for Let's Encrypt expiry notices.
ACME_EMAIL=

# Host port the app publishes in plain Docker. In production set to
# 127.0.0.1:8080 so only Caddy (80/443) is public:
APP_PORT=127.0.0.1:8080

# ── DATABASE ──────────────────────────────────────────────────
# Overridden by Compose to the `db` service host; use localhost for a
# plain PHP install. DB_USER/DB_PASSWORD are also what Compose creates.
DB_HOST=db
DB_NAME=registrar_ai
DB_USER=registrar
DB_PASSWORD=your-strong-db-password-here
DB_ROOT_PASSWORD=your-strong-db-root-password-here   # MariaDB root (Docker only)
DB_CHARSET=utf8mb4

# ── APPLICATION ENVIRONMENT ───────────────────────────────────
# 'production' = errors logged, not displayed. 'development' = verbose.
APP_ENV=production

# ── SESSION TIMEOUT ────────────────────────────────────────────
# Idle session timeout in seconds. Default: 1200 (20 minutes). 0 disables.
SESSION_IDLE_TIMEOUT=1200

# ── SECURITY: JWT & KIOSK ACCESS ──────────────────────────────
# CRITICAL: strong, unique values in production.
#   generate with:  openssl rand -hex 32
JWT_SECRET=your-very-strong-jwt-secret-min-64-chars-openssl-rand-hex-32
KIOSK_ACCESS_TOKEN=your-strong-kiosk-token-min-32-chars

# ── AI GATEWAY (9Router / Antigravity, OpenAI-compatible) ──────
# Gateway base URL; the app appends /v1/chat/completions.
# Local 9Router default is http://localhost:20128. On a VPS/tunnel point
# NINEROUTER_URL at your gateway. Empty = AI features degrade gracefully.
NINEROUTER_URL=
AI_API_KEY=your-ai-gateway-api-key-if-required

# ── PAYMENTS (PayMongo) ────────────────────────────────────────
# Empty => built-in mock / COD path. Real values in production.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ── EMAIL (SMTP) ───────────────────────────────────────────────
# Shared/mail_client.php uses SMTP_*; senders no-op when unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@bestlink.edu.ph
SMTP_PASS=your-app-password
MAIL_FROM=no-reply@bestlink.edu.ph
MAIL_FROM_NAME=BCP Registrar System

# ── LOGGING & MONITORING ──────────────────────────────────────
# Path to PHP error log (inside the container when under Docker).
LOG_PATH=/var/log/registrar-ai/php_errors.log
# Optional: Sentry error tracking.
SENTRY_DSN=
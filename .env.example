# ============================================================
# ENVIRONMENT CONFIGURATION - COPY TO .env FOR DEPLOYMENT
# ============================================================
# This file documents all environment variables the system reads.
# NEVER commit actual secrets—use .env (gitignored) for production values.
# Recommended: Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)

# ── DATABASE ──────────────────────────────────────────────────
# Override database connection settings. Defaults: localhost, root, empty password
DB_HOST=localhost
DB_NAME=registrar_ai
DB_USER=root
DB_PASSWORD=your-strong-db-password-here
DB_CHARSET=utf8mb4

# ── APPLICATION ENVIRONMENT ───────────────────────────────────
# Set to 'production' to disable error display (logged to file instead)
# Set to 'development' for local debugging (shows errors on screen)
APP_ENV=production

# ── SESSION TIMEOUT ────────────────────────────────────────────
# Idle session timeout in seconds. Default: 1200 (20 minutes)
# Set to 0 to disable idle logout entirely (not recommended)
SESSION_IDLE_TIMEOUT=1200

# ── SECURITY: JWT & KIOSK ACCESS ──────────────────────────────
# CRITICAL: These must be strong, unique values in production
# Generate with: openssl rand -hex 32
JWT_SECRET=your-very-strong-jwt-secret-min-64-chars-openssl-rand-hex-32
KIOSK_ACCESS_TOKEN=your-strong-kiosk-token-min-32-chars

# ── AI GATEWAY (9Router or OpenAI-compatible) ──────────────────
# Local 9Router gateway URL (default: http://localhost:20128)
# Can be overridden to a remote VPS or tunnel URL
NINEROUTER_URL=http://localhost:20128

# AI API key for authentication (if required by gateway)
# Leave empty if gateway doesn't require authentication
AI_API_KEY=your-ai-gateway-api-key-if-required

# ── OTP CONFIGURATION ──────────────────────────────────────────
# IMPORTANT: Set to 'false' in production (disables on-screen OTP fallback)
# Only set to 'true' for development when mail() is unavailable
OTP_SHOW_ONSCREEN=false

# ── EMAIL / NOTIFICATIONS ──────────────────────────────────────
# Optional: Configure SMTP for reliable email delivery (mail() is unreliable)
# If not set, system falls back to PHP mail() function
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@bestlink.edu.ph
MAIL_PASSWORD=your-app-password
MAIL_FROM=no-reply@bestlink.edu.ph
MAIL_FROM_NAME=BCP Registrar System

# ── LOGGING & MONITORING ──────────────────────────────────────
# Path to PHP error log (ensure directory is writable)
LOG_PATH=/var/log/registrar-ai/php_errors.log

# Optional: Sentry error tracking (for production monitoring)
SENTRY_DSN=

# ── HTTPS / SSL ────────────────────────────────────────────────
# Set to 'true' in production to enable HTTPS-only cookies and HSTS
USE_HTTPS=true

# ── CORS CONFIGURATION ─────────────────────────────────────────
# For production, restrict CORS origins instead of '*'
# Example: CORS_ALLOWED_ORIGINS=https://registrar.bestlink.edu.ph,https://kiosk.bestlink.edu.ph
CORS_ALLOWED_ORIGINS=*

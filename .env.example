# Copy to .env and edit. .env is gitignored (never commit secrets).
# Loaded automatically by `docker compose`.

# ── Deployment / domain (used by docker-compose.prod.yml, deploy) ──────────
# Public hostname where the app will be reached (Caddy provisions TLS for it).
DOMAIN=your.domain
# Optional: email for Let's Encrypt expiry notices.
ACME_EMAIL=

# ── Database ──────────────────────────────────────────────────────────────
DB_NAME=registrar_ai
DB_USER=registrar
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-root-strong

# ── Application ───────────────────────────────────────────────────────────
# App port. In production set to 127.0.0.1:8080 so only Caddy (80/443) is public:
APP_PORT=127.0.0.1:8080
# development (verbose errors) or production (errors logged only)
APP_ENV=production

# Change before going live (long random strings):
JWT_SECRET=replace-with-a-long-random-string
KIOSK_ACCESS_TOKEN=replace-with-a-random-kiosk-token

# ── AI gateway (9Router / Antigravity / 9Router) ───────────────────────────
# Leave NINEROUTER_URL empty to run with AI features degraded (app still works).
# Point at your gateway/VPS/tunnel, e.g. https://my-gateway.example.com
NINEROUTER_URL=
AI_API_KEY=

# ── Payments (PayMongo) — optional, mock fallback when empty ───────────────
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ── Email (SMTP) — optional, senders no-op when unset ─────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=BCP Registrar System
# Deny everything in this directory, including directory listing.
# Duplicated from the root .htaccess on purpose: that one stops applying
# the day an override turns AllowOverride off, and this directory holds
# generated report text.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes

# ============================================================
#  .htaccess — Browser caching & basic protections
# ============================================================

# ── Browser caching for static assets (mod_headers) ─────────
# Works with the default XAMPP setup (mod_headers is loaded).
<IfModule mod_headers.c>
    # Cache CSS/JS for 1 month
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Cache images/fonts for 1 month
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Never cache PHP/HTML pages themselves
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── Expires headers (requires mod_expires to be enabled) ─────
# If you enable mod_expires in httpd.conf, this takes over.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
</IfModule>

# ── Document verification pretty URLs (spec §7) ───────────────
# /verify/<qr_hash> → verify.php?qr=<qr_hash>. verify.php?qr=HASH
# remains the canonical path and always works without rewriting.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^verify/([A-Za-z0-9]{32,64})$ verify.php?qr=$1 [L,QSA]
</IfModule>

# ── PHP execution time ────────────────────────────────────────────────
# For mod_php hosts. .user.ini covers PHP-FPM/CGI shared hosting; this block
# is the equivalent for Apache with mod_php, and the two do not overlap.
#
# An AI Insight report is a synchronous upstream call measured at 40-65s. The
# stock 30s limit kills the script partway through the response, so the browser
# receives a truncated body, the JSON never parses, and the page reports only
# that the analysis "failed". Raising the limit is what stops that.
#
# php_flag is only legal when PHP runs as a module; under CGI/FPM it would be a
# 500 on every request, hence the IfModule guard.
<IfModule mod_php.c>
    php_value max_execution_time 180
</IfModule>

